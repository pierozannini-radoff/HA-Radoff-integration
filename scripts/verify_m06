#!/usr/bin/env bash
#
# Tutte le verifiche della card M-06 (RT-2945), in ordine, in un colpo solo.
#
#   ./scripts/verify_m06              # tutto, verifica dal vivo compresa
#   ./scripts/verify_m06 --offline    # salta la passata su dev (nessuna rete)
#
# Le credenziali si leggono da .env (gitignored), come RADOFF_USERNAME /
# RADOFF_PASSWORD: questo script non le contiene e non le stampa.
#
# I due override di pool servono finche' const.py punta a un pool diverso
# dall'ambiente di DEFAULT_BASE_URL - vedi «Un residuo che blocca il
# collaudo end-to-end» in docs/M-04-verifica-dev.md. Sovrascrivibili
# dall'ambiente:  M06_POOL_ID=... M06_DOMAIN_PREFIX=... ./scripts/verify_m06

set -uo pipefail

cd "$(dirname "$0")/.."

POOL_ID="${M06_POOL_ID:-eu-west-1_5SsvW9t6S}"
CLIENT_ID="${M06_CLIENT_ID:-2i63gbc9sim3b8paasaga7jb6g}"
DOMAIN_PREFIX="${M06_DOMAIN_PREFIX:-875fe89b}"

OFFLINE=0
[[ "${1:-}" == "--offline" ]] && OFFLINE=1

FAILED=()

# Errori mypy preesistenti a questa card, misurati su 18c0870 (fine M-05).
MYPY_BASELINE="${MYPY_BASELINE:-21}"

# I file che M-06 riscrive: qui un errore di tipo non e' debito ereditato.
MYPY_OWNED='custom_components/radoff/(entity|sensor)\.py|custom_components/radoff/api/(models|client)\.py'

check_types() {
    local output count owned
    output="$(python3 -m mypy custom_components/radoff 2>&1)"
    count="$(printf '%s\n' "${output}" | grep -cE '^custom_components/.*error:')"

    # `import-untyped` sugli stub di requests e' ambientale, non nostro.
    owned="$(printf '%s\n' "${output}" \
        | grep -E "^(${MYPY_OWNED})" \
        | grep 'error:' \
        | grep -v 'import-untyped' || true)"

    echo "    errori totali: ${count} (baseline ${MYPY_BASELINE})"
    if [[ -n "${owned}" ]]; then
        echo "    errori nei file di questa card:"
        printf '%s\n' "${owned}" | sed 's/^/      /'
        return 1
    fi
    [[ "${count}" -le "${MYPY_BASELINE}" ]]
}

step() {
    local name="$1"
    shift
    echo
    echo "═══ ${name}"
    echo "    \$ $*"
    echo
    if "$@"; then
        echo
        echo "    ✓ ${name}"
    else
        echo
        echo "    ✗ ${name}"
        FAILED+=("${name}")
    fi
}

echo
echo "  Verifiche della card M-06 (RT-2945) - disponibilita' da connection_status"
echo "  branch: $(git branch --show-current)"

# 1. Formattazione e lint. --check non riscrive nulla: se fallisce, il
#    comando da lanciare e' ./scripts/lint, che formatta e corregge.
step "Formattazione (nessuna riscrittura)" ruff format --check .
step "Lint" ruff check .

# 2. La suite intera. Non solo i test di questa card: togliere la soglia di
#    freschezza cambia cosa mostra un'entita' senza lettura, che e' una cosa
#    che test scritti per M-03 e M-04 asserivano per conto loro.
step "Suite completa" python3 -m pytest -q

# 3. Gli AC di questa card, isolati e con i nomi in chiaro: serve a leggere
#    quale criterio e' coperto da quale test, non a coprire di piu'.
#
#    AC1 connected + telemetry: null      -> test_a_connected_device_without_telemetry_keeps_its_entities_available
#    AC2 non connesso -> non disponibile  -> test_availability_follows_connection_status[disconnected-False]
#    AC3 valore mai visto -> WARNING      -> test_an_unknown_connection_status_warns_once
#    AC4 429/ciclo fallito != offline     -> test_a_429_skips_the_cycle_without_making_entities_unavailable
#                                            + test_a_500_costs_the_whole_cycle
#    AC5 il moltiplicatore non esiste     -> test_the_staleness_multiplier_is_gone_from_the_codebase
#    AC6 entrambi i timestamp negli attr. -> test_the_diagnostic_attributes_carry_both_timestamps
step "AC di M-06, uno per riga" python3 -m pytest -v --no-cov -p no:randomly \
    tests/test_sensor.py \
    tests/test_coordinator.py \
    -k "connection or availability or timestamps or multiplier or telemetry or restores or 429 or 500 or silent or missing_field"

# 4. I due file che la card nomina come "verdi": interi, non filtrati.
step "test_sensor.py e test_init.py interi" python3 -m pytest -q --no-cov \
    tests/test_sensor.py tests/test_init.py

# 5. I tipi. mypy su questo repo esce 1 da prima di questa card - 21 errori
#    in config_flow.py, repairs.py, coordinator.py e gli stub di requests -
#    quindi passarlo a `step` cosi' com'e' farebbe fallire lo script sempre.
#    Il criterio e' quello vero: il conto non sale, e nessun errore arriva
#    dai quattro file che questa card riscrive.
step "Tipi: nessun errore nuovo (baseline ${MYPY_BASELINE})" check_types

# 6. La passata dal vivo su dev. E' l'unica che tocca la rete e l'unica che
#    puo' dire quali valori di connection_status l'API serva davvero e
#    quanto sia vecchio connection_status_updated_at sui device connessi.
if [[ "${OFFLINE}" -eq 1 ]]; then
    echo
    echo "═══ Verifica dal vivo su dev"
    echo "    saltata (--offline)"
else
    step "Verifica dal vivo su dev" python3 scripts/verify_m06_live.py \
        --pool-id "${POOL_ID}" \
        --client-id "${CLIENT_ID}" \
        --domain-prefix "${DOMAIN_PREFIX}"
fi

echo
echo "═══════════════════════════════════════════════════════════════"
if [[ ${#FAILED[@]} -eq 0 ]]; then
    echo "  Tutto verde."
else
    echo "  Falliti: ${#FAILED[@]}"
    for name in "${FAILED[@]}"; do
        echo "    - ${name}"
    done
fi

cat <<'NOTE'

  Restano due cose che nessuno script puo' fare, ed entrambe si guardano
  con ./scripts/develop:

    1. Un device connesso e muto mostra l'ultimo valore noto e non
       "non disponibile". Su dev il caso e' il sense 57FA28 del dominio
       875fe89b: dopo M-04 ha 10 entita'; con questa card devono essere
       disponibili, non unavailable.
    2. Il riavvio. Fermare Home Assistant, riavviarlo, e verificare che
       quelle entita' tornino con il loro ultimo valore e con
       last_measured_at vecchio - non con un timestamp fresco, che e'
       proprio la bugia che l'attributo esiste per impedire.

NOTE

[[ ${#FAILED[@]} -eq 0 ]] || exit 1
exit 0
